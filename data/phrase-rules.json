{
  "about": "English → Scots translator rules (Glasgow / West Central by default). Rules are tried in order, before word-by-word translation; the first one that matches wins, so put specific patterns above general ones. In 'match', {name} is a slot that takes one to three words. 'cases' pick an answer from what is in the slot; 'otherwise' is used when no case fits, and {name} in it is replaced by the slot, translated. A rule with just 'say' replaces the words as they are. 'words' are single-word choices that beat the word list. 'never_use' words are never given as a translation. Any 'say', 'otherwise' or word can be a list when more than one form is right – the first is shown and you tap the word in the translation to see the others.",
  "never_use": [
    "cuppa",
    "shoosh",
    "snout",
    "yon"
  ],
  "slot_stops": [
    "please",
    "and",
    "now",
    "mate",
    "pal",
    "but",
    "thanks",
    "then"
  ],
  "rules": [
    {
      "name": "Asking for a drink",
      "match": [
        "give me a drink of {drink}",
        "gimme a drink of {drink}",
        "can i get a drink of {drink}",
        "can i have a drink of {drink}",
        "could i get a drink of {drink}",
        "could i have a drink of {drink}",
        "give us a drink of {drink}"
      ],
      "cases": [
        {
          "when": [
            "water"
          ],
          "say": [
            "gies a drap ae watter",
            "gies a drink ae watter"
          ]
        },
        {
          "when": [
            "whisky",
            "whiskey",
            "scotch"
          ],
          "say": [
            "gies a dram",
            "gies a wee dram"
          ]
        },
        {
          "when": [
            "alcohol",
            "booze",
            "liquor",
            "drink"
          ],
          "say": [
            "gies a swally",
            "gies a bevvy"
          ]
        },
        {
          "when": [
            "juice",
            "soda",
            "pop",
            "fizzy drink",
            "fizzy juice",
            "lemonade",
            "cola",
            "coke"
          ],
          "say": [
            "gies a drink ae ginger",
            "gies some ginger"
          ]
        },
        {
          "when": [
            "tea"
          ],
          "say": [
            "gies a mug ae tea",
            "gies a cup ae tea"
          ]
        }
      ],
      "otherwise": [
        "gies a drink ae {drink}",
        "gies a drink o {drink}"
      ]
    },
    {
      "name": "That thing over there",
      "match": [
        "that {thing} over there",
        "that {thing} over yonder",
        "those {thing} over there"
      ],
      "otherwise": [
        "that {thing} ower there",
        "thon {thing} ower there"
      ]
    },
    {
      "name": "Over there",
      "match": [
        "over there",
        "over yonder",
        "yonder"
      ],
      "say": [
        "ower there",
        "o'er there"
      ]
    },
    {
      "name": "Give me",
      "match": [
        "give me",
        "gimme",
        "give us"
      ],
      "say": [
        "gies",
        "gie's",
        "gimme"
      ]
    },
    {
      "name": "Going to a place",
      "match": [
        "going to the",
        "going to a",
        "going to my",
        "going to your",
        "going to his",
        "going to her",
        "going to our"
      ],
      "say": [
        "gaun tae",
        "gawn tae"
      ],
      "keep_last": true
    },
    {
      "name": "Going to (do something)",
      "match": [
        "going to",
        "gonna"
      ],
      "say": [
        "gonnae",
        "gonny",
        "gaun tae"
      ]
    },
    {
      "name": "Don't know",
      "match": [
        "i don't know",
        "i dont know",
        "i do not know"
      ],
      "say": [
        "Ah dunno",
        "Ah dinny ken",
        "Ah dinnae ken",
        "Ah don't know"
      ]
    },
    {
      "name": "Will you not",
      "match": [
        "will you not",
        "would you not",
        "please don't"
      ],
      "say": [
        "gonnae no",
        "gonny no",
        "will ye no"
      ]
    },
    {
      "name": "Be quiet",
      "match": [
        "be quiet",
        "shut up",
        "keep quiet"
      ],
      "say": [
