        "the morra",
        "the morn"
      ]
    },
    {
      "name": "You (more than one)",
      "match": [
        "you all",
        "you lot",
        "you guys",
        "all of you"
      ],
      "say": [
        "yous",
        "yiz",
        "yeez"
      ]
    }
  ],
